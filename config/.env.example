# Copy to config/.env (gitignored) and fill in. Rotate the old burned token
# via @BotFather. On GitHub Actions these come from repo secrets (see
# docs/RUNBOOK.md §0); real env vars win over this file.

# Main alerts chat — new links, and result bundles (matched-students PDF,
# source result PDF, check-before-forwarding summary, one ready-to-forward
# parent message per matched student).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Health / heartbeat chat — one ✅/❌ status line after every monitor run.
HEALTH_BOT_TOKEN=
HEALTH_CHAT_ID=

# Optional: external dead-man's-switch (healthchecks.io or equivalent) ping
# URL, if you wire one up. Leave blank to disable.
HEALTHCHECKS_URL=
